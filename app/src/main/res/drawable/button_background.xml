<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#CCCCCC"/> <!-- Color when button is pressed -->
            <corners android:radius="25dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FFFFFF"/> <!-- Normal color -->
            <corners android:radius="25dp"/>
            <stroke
                android:width="2dp"
                android:color="#000000"/> <!-- Border color -->
        </shape>
    </item>
</selector>
